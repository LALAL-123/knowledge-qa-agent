[
  {"doc_id": "D01", "title": "费用报销管理办法", "version_date": "2025-03-01", "scope": "未注明", "snippets": [
    {"snippet_id": "D01-S1", "text": "报销期限：员工应在费用发生后 30 天内提交报销申请，逾期不予受理。"},
    {"snippet_id": "D01-S2", "text": "报销需附合规发票，发票抬头须与公司名称一致。"}]},
  {"doc_id": "D02", "title": "差旅与报销补充说明", "version_date": "2026-01-15", "scope": "未注明", "snippets": [
    {"snippet_id": "D02-S1", "text": "报销时限为费用发生后 15 天内，请各部门及时提交。"},
    {"snippet_id": "D02-S2", "text": "出差期间的市内交通费按实际发生额凭票报销。"}]},
  {"doc_id": "D03", "title": "员工休假制度（年假）", "version_date": "2025-07-01", "scope": "全体正式员工", "snippets": [
    {"snippet_id": "D03-S1", "text": "员工带薪年休假（以下简称年假）：累计工作已满 1 年不满 10 年的，年假 5 天；已满 10 年不满 20 年的，年假 10 天；已满 20 年的，年假 15 天。"},
    {"snippet_id": "D03-S2", "text": "年休假可分段使用，当年未休部分可顺延至次年 3 月 31 日前。"}]},
  {"doc_id": "D04", "title": "X1 运动相机产品 FAQ", "version_date": "2026-05-10", "scope": "X1 全系", "snippets": [
    {"snippet_id": "D04-S1", "text": "X1 支持 4K 60 帧视频录制。"},
    {"snippet_id": "D04-S2", "text": "X1 电池续航约 120 分钟（1080p 录制、常温环境）。"},
    {"snippet_id": "D04-S3", "text": "X1 机身防水深度 10 米，无需额外防水壳。"}]},
  {"doc_id": "D05", "title": "差旅住宿标准", "version_date": "2026-02-01", "scope": "国内出差", "snippets": [
    {"snippet_id": "D05-S1", "text": "一线城市（北京、上海、广州、深圳）住宿每晚不超过 500 元。"},
    {"snippet_id": "D05-S2", "text": "二线城市住宿每晚不超过 350 元；其他城市不超过 250 元。"}]},
  {"doc_id": "D06", "title": "加班与调休规定", "version_date": "2025-09-01", "scope": "全体员工", "snippets": [
    {"snippet_id": "D06-S1", "text": "工作日加班可申请等时长调休，调休须在 3 个月内使用。"}]}
]
